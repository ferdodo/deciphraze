		"happy-dom": "^20.4.0",
		"tasuku": "^2.0.7",
		"typescript": "^5.4.5",
		"vite": "^8.0.7",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"htm": "^3.1.1",
		"hyperscript": "^2.0.2",
		"rxjs": "^7.8.1"
