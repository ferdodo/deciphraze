{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"moduleResolution": "nodenext",
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"downlevelIteration": true,
		"jsx": "react-jsx",
		"target": "ES2020",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "NodeNext",
		"typeRoots": ["./node_modules/@types", "./src/types"]
	},
	"include": ["src/**/*", "src/types/**/*"]
}
