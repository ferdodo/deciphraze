{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "vitest",
	"coverageAnalysis": "perTest",
	"mutate": ["./src/**/*.ts", "!./src/**/*.test.ts"],
	"thresholds": {
		"high": 70,
		"low": 65,
		"break": 60
	},
	"reporters": ["html", "json"],
	"htmlReporter": {
		"fileName": "public/stryker-report.html"
	},
	"jsonReporter": {
		"fileName": "public/stryker-report.json"
	}
}
