{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "vitest",
	"coverageAnalysis": "perTest",
	"mutate": ["./src/**/*.ts", "!./src/**/*.test.ts", "!./src/constants/*.ts", "!./src/mocks/*.ts"],
	"thresholds": {
		"high": 80,
		"low": 75,
		"break": 82
	},
	"reporters": ["html", "json", "clear-text"],
	"htmlReporter": {
		"fileName": "public/stryker-report.html"
	},
	"jsonReporter": {
		"fileName": "public/stryker-report.json"
	},
	"clearTextReporter": {
		"reportMutants": true
	}
}
